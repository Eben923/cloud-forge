# Cloud Forge Configuration Template
# Copy this file to .env and configure your local settings.

# PostgreSQL connection string (SQLAlchemy + psycopg 3)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/cloudforge

# Allowed origins for CORS (comma-separated, optional)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173