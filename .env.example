# Cloud Forge Configuration Template
# Copy this file to .env and configure your local settings.

# 1. Database Connection (PostgreSQL with psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://cloudforge:<YOUR_LOCAL_DB_PASSWORD>@localhost:5432/cloudforge

# 2. AWS Parameter Store DB Credentials (Optional: used on EC2)
# When set, the application retrieves the DB password from SSM Parameter Store at startup
# SSM_DB_PASSWORD_PARAM=/cloudforge/db_password
# DB_USER=cloudforge
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=cloudforge

# 3. AWS S3 Artifact Storage (Optional: fallback to local uploaded_projects/ if unset)
# S3_BUCKET=cloudforge-artifacts-123456789012-ap-southeast-2
# AWS_REGION=ap-southeast-2

# 4. Authentication (Optional: when set, all endpoints except /health require X-API-Key header)
# API_KEY=your_secret_api_key_here

# 5. Allowed origins for CORS (comma-separated, optional)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
